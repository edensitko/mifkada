{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mifkada",
  "mainBinaryName": "Mifkada",
  "version": "../package.json",
  "identifier": "dev.mifkada.app",
  "build": {
    "frontendDist": "stub"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist",
      "files": {
        "Resources/he.lproj/InfoPlist.strings": "locales/he.lproj/InfoPlist.strings",
        "Resources/en.lproj/InfoPlist.strings": "locales/en.lproj/InfoPlist.strings"
      },
      "signingIdentity": "-"
    },
    "resources": {
      "stage/app/": "app/",
      "stage/node": "node"
    }
  }
}